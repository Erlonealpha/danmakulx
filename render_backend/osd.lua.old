
---@param idx int
---@param idx_map _idx_map
---@param left_time number
---@param danmakus _calced_danmaku[]
---@return int
---@return int
local function _calc_offset(idx, idx_map, left_time, danmakus)
    if danmakus[idx_map[idx]]--[[@cast -?]]._dirty == false then
        return 0, -1
    end
    ---@param start int
    ---@param map _idx_map
    ---@param depth int
    ---@return int, int
    local function _calc_offset_iter(start, map, depth)
        for i = start, 1, -1 do
            local d = danmakus[map[i]]
            ---@cast d -?
            if d._dirty == false then
                if i == start and depth > 0 then
                    return depth-1, 1
                else
                    return depth, math.max(i+1, start)
                end
            end
            if d.end_time < left_time then
                if i == start and depth > 0 then
                    return depth-1, 1
                else
                    return depth, math.max(i+1, start)
                end
            end
        end
        if left_time < 0 then
            return depth, 1
        end
        if map.prev ~= nil then
            return _calc_offset_iter(#map.prev, map.prev, depth+1)
        else
            return depth, 1
        end
    end
    return _calc_offset_iter(idx, idx_map, 0)
end